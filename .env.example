# Copy to .env (git-ignored) and fill in. One numbered block per account: BSKY_1_*, BSKY_2_*, ...
# Numbering must be contiguous; reading stops at the first missing BSKY_<n>_HANDLE.

BSKY_1_HANDLE=your-handle.bsky.social
# An app password (Settings > Privacy and security > App passwords), never your main password.
BSKY_1_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Comma-separated bare domains; subdomains match too (example.com also matches videos.example.com).
BSKY_1_DOMAINS=example.com
# Optional, defaults to https://bsky.social
# BSKY_1_SERVICE=https://bsky.social

# BSKY_2_HANDLE=another-handle.example.com
# BSKY_2_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# BSKY_2_DOMAINS=example.org,example.net
